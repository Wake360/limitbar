{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "limitbar",
  "version": "0.1.0",
  "identifier": "com.filipvachek.limitbar",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "limitbar", "width": 420, "height": 640, "minWidth": 340, "minHeight": 400, "visible": false }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "shortDescription": "Subscription usage limits for Claude, Codex, Gemini and Grok",
    "linux": { "deb": { "depends": ["libayatana-appindicator3-1"] } }
  }
}
